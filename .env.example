# ---- core ----
NODE_ENV=development
PORT=3000
# App role: unprivileged, so row-level security actually applies to it.
DATABASE_URL=postgres://tc_app:tc_app_local@localhost:5434/tc_attendance
# Owner role: used only by `npm run db:migrate` and drizzle-kit.
MIGRATION_DATABASE_URL=postgres://attendance:attendance@localhost:5434/tc_attendance
APP_BASE_URL=http://localhost:3000
DEFAULT_TIMEZONE=Asia/Kolkata
AUTH_SECRET=change-me

# Global brake. While true, no message, call or HRMS write reaches anyone real.
DRY_RUN=true

# ---- WhatsApp (Meta Cloud API) ----
# Per-tenant values live in the database; these are the platform fallbacks.
WA_GRAPH_VERSION=v23.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=

# ---- models (any subset; the gateway routes by task and language) ----
# Azure OpenAI (tc-attendance-aoai). Models are deployment names.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://tc-attendance-aoai.openai.azure.com/openai/v1
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-m
SARVAM_STT_MODEL=saarika:v2
SARVAM_TTS_MODEL=bulbul:v2

# ---- voice ----
VOICE_PROVIDER=fake
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_FROM_NUMBER=
# Where to forward calls that arrive on the Plivo number (e.g. Meta's verification call)
PLIVO_FORWARD_NUMBER=

# ---- HRMS ----
HRMS_CONNECTOR=mock
MOCK_HRMS_URL=http://localhost:4010
