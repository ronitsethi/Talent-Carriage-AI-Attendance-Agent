PORT=3000
DATABASE_URL=postgres://attendance:attendance@localhost:5433/attendance
TZ_NAME=Asia/Kolkata

# Dashboard opens only on this computer (http://localhost). Set true to allow other computers
# (only on a trusted network, never with ngrok running).
DASHBOARD_REMOTE_ACCESS=false

# WhatsApp Cloud API (Meta)
WA_DRY_RUN=true                 # true = log messages only, nothing is sent
WA_GRAPH_VERSION=v23.0
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_TEMPLATE_NAME=attendance_absent_check
WA_TEMPLATE_LANG=en
WA_TEMPLATE_BUTTONS=4           # number of quick-reply buttons on the approved template (0 if none)

# OpenAI - classifies free-text replies
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
