# Copy to agent/.env, or export these before running the worker.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The platform this agent reports to.
APP_BASE_URL=http://localhost:3000
AGENT_API_TOKEN=

OPENAI_API_KEY=

# The voice. Run `npm run voices` to hear the choices.
AGENT_VOICE=ritu
AGENT_VOICE_MODEL=bulbul:v3-beta
AGENT_VOICE_PACE=0.95
AGENT_STT=sarvam
SARVAM_API_KEY=
